{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-luna",
  "default_agent": "build",
  "agents": {
    "build": {
      "model": "openai/gpt-6-luna#medium"
    },
    "plan": {
      "model": "openai/gpt-6.2-sol#medium"
    },
    "architect": {
      "description": "Consult ONLY for genuinely complex architecture or hard diagnosis. Answer one focused question concisely, then return to the Luna implementer. Read-only.",
      "mode": "subagent",
      "model": "openai/gpt-6.2-sol#medium",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        }
      ]
    },
    "reviewer": {
      "description": "Perform ONE focused final diff review, prioritizing correctness, data loss, security and regressions. Read-only; no whole-project exploration or repeated follow-up reviews.",
      "mode": "subagent",
      "model": "openai/gpt-6-luna#medium",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        }
      ]
    },
    "general": {
      "model": "openai/gpt-6-luna#medium"
    },
    "explore": {
      "model": "openai/gpt-6-luna#low"
    },
    "compaction": {
      "model": "openai/gpt-6-luna#low"
    },
    "title": {
      "model": "openai/gpt-6-luna#low"
    },
    "summary": {
      "model": "openai/gpt-6-luna#low"
    }
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6.2-sol": {
          "settings": {
            "reasoningEffort": "medium"
          }
        },
        "gpt-6-luna": {
          "settings": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "plugins": [
    "-superpowers",
    "-superpowers.*",
    "-superpowers@git+https://github.com/obra/superpowers.git#v7.0.2"
  ],
  "mcp": {
    "servers": {
      "dart": {
        "type": "local",
        "command": [
          "dart",
          "mcp-server"
        ]
      },
      "maestro": {
        "type": "local",
        "command": [
          "maestro",
          "mcp"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "--yes",
          "@playwright/mcp@0.0.86"
        ]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "--yes",
          "chrome-devtools-mcp@1.13.0"
        ],
        "disabled": true
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push -f *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh pr merge *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh api *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh release create *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "flutter pub publish *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean -fd*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "brainstorming",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "writing-plans",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "executing-plans",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "subagent-driven-development",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "using-git-worktrees",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "finishing-a-development-branch",
      "effect": "deny"
    }
  ]
}
